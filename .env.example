# Copy this file to .env.local (never commit .env.local).
# Only NEXT_PUBLIC_* variables are visible in the browser. Restart `npm run dev` after changing this file.

# HW1: true  → the screens use the mock data in src/mock (no backend needed)
# HW2: false → the screens call the real API below
NEXT_PUBLIC_USE_MOCK=true

# Base URL of your backend API (used when NEXT_PUBLIC_USE_MOCK=false).
# The bundled example API runs with `npm run mock-api` on this address.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
